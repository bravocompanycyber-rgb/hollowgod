; Engine configuration file. HOLLOWGOD prototype for Godot 3.5
config_version=4

[application]

config/name="HOLLOWGOD"
config/icon="res://icon.png"
run/main_scene="res://scenes/Title.tscn"

[autoload]

Inputs="*res://scripts/Inputs.gd"
FX="*res://scripts/FX.gd"
Art="*res://scripts/Art.gd"
Game="*res://scripts/Game.gd"
Sfx="*res://scripts/Sfx.gd"

[display]

window/size/width=1280
window/size/height=720
window/size/test_width=1152
window/size/test_height=648
window/stretch/mode="2d"
window/stretch/aspect="keep"
window/vsync/use_vsync=true

[rendering]

quality/driver/driver_name="GLES2"
quality/2d/use_pixel_snap=true
environment/default_clear_color=Color( 0.03, 0.03, 0.06, 1 )
