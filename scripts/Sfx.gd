extends Node
# Sound effects and ambient music, generated by code (no audio files needed).
# Later we can replace these with real recorded sounds and music.

const RATE = 22050

const FILES = {
    "click": "ui_click", "back": "ui_back", "open": "ui_open", "close": "ui_close", "pickup": "pickup",
    "levelup": "levelup", "error": "error", "gate": "gate", "parry": "parry", "drop": "drop", "door": "door"
}

var music_vol = 0.8
var sfx_vol = 1.0
var sounds = {}
var pool = []
var music_player = null
var music_streams = {}
var current_music = ""

func _ready():
    pause_mode = Node.PAUSE_MODE_PROCESS
    for kind in [["hit", 0.10], ["kill", 0.28], ["dash", 0.16], ["swing", 0.09], ["hurt", 0.30], ["pickup", 0.22], ["click", 0.06],
                 ["door", 0.45], ["boss", 0.60], ["parry", 0.18], ["levelup", 0.50], ["shoot", 0.14], ["slam", 0.40]]:
        sounds[kind[0]] = _synth(kind[0], kind[1])
    # Real recorded sounds (CC0) replace generated ones where we have them
    for k in FILES.keys():
        var st = _load_wav("res://assets/audio/" + FILES[k] + ".wav")
        if st != null:
            sounds[k] = st
    for i in range(8):
        var p = AudioStreamPlayer.new()
        add_child(p)
        pool.append(p)
    music_player = AudioStreamPlayer.new()
    music_player.volume_db = -15.0 + _db(music_vol)
    add_child(music_player)
    music_streams["run"] = _drone([55.0, 82.5, 110.0, 165.0])
    music_streams["hub"] = _drone([65.5, 98.25, 131.0, 196.5])
    music_streams["rime"] = _drone([73.5, 110.25, 147.0, 220.5])
    music_streams["obsidian"] = _drone([61.75, 92.625, 123.5, 185.25])
    music_streams["hollow"] = _drone([49.0, 69.5, 103.0, 155.5])
    Game.apply_settings()

func play(name, vol = 0.0, pitch = 1.0):
    if not sounds.has(name):
        return
    for p in pool:
        if not p.playing:
            _go(p, name, vol, pitch)
            return
    _go(pool[0], name, vol, pitch)

func _go(p, name, vol, pitch):
    p.stream = sounds[name]
    p.volume_db = vol + _db(sfx_vol)
    p.pitch_scale = pitch * rand_range(0.94, 1.06)
    p.play()

func _db(v):
    if v <= 0.001:
        return -80.0
    return linear2db(v)

func set_volumes(m, s):
    music_vol = m
    sfx_vol = s
    if music_player != null:
        music_player.volume_db = -15.0 + _db(music_vol)

func _load_wav(path):
    if ResourceLoader.exists(path):
        var r = load(path)
        if r is AudioStream:
            return r
    var f = File.new()
    if f.open(path, File.READ) != OK:
        return null
    var bytes = f.get_buffer(f.get_len())
    f.close()
    if bytes.size() < 44:
        return null
    var pos = 12
    var channels = 1
    var rate = 44100
    var bits = 16
    var data = null
    while pos + 8 <= bytes.size():
        var id = bytes.subarray(pos, pos + 3).get_string_from_ascii()
        var size = bytes[pos + 4] | (bytes[pos + 5] << 8) | (bytes[pos + 6] << 16) | (bytes[pos + 7] << 24)
        if id == "fmt ":
            channels = bytes[pos + 10] | (bytes[pos + 11] << 8)
            rate = bytes[pos + 12] | (bytes[pos + 13] << 8) | (bytes[pos + 14] << 16) | (bytes[pos + 15] << 24)
            bits = bytes[pos + 22] | (bytes[pos + 23] << 8)
        elif id == "data":
            var end = int(min(pos + 8 + size, bytes.size())) - 1
            data = bytes.subarray(pos + 8, end)
            break
        pos += 8 + size + (size % 2)
    if data == null or bits != 16:
        return null
    var st = AudioStreamSample.new()
    st.format = AudioStreamSample.FORMAT_16_BITS
    st.mix_rate = rate
    st.stereo = channels == 2
    st.data = data
    return st

func music(name):
    if name == current_music:
        return
    current_music = name
    if music_streams.has(name):
        music_player.stream = music_streams[name]
        music_player.play()
    else:
        music_player.stop()

func toggle_mute():
    AudioServer.set_bus_mute(0, not AudioServer.is_bus_mute(0))
    return AudioServer.is_bus_mute(0)

func _synth(kind, dur):
    var n = int(RATE * dur)
    var bytes = PoolByteArray()
    bytes.resize(n * 2)
    var notes = [523.0, 659.0, 784.0, 1046.0]
    for i in range(n):
        var t = float(i) / RATE
        var k = float(i) / n
        var v = 0.0
        var nz = randf() * 2.0 - 1.0
        if kind == "hit":
            v = nz * pow(1.0 - k, 3.0) * 0.7 + sin(TAU * 170.0 * t) * pow(1.0 - k, 2.0) * 0.6
        elif kind == "kill":
            v = sin(TAU * (320.0 - 220.0 * k) * t) * pow(1.0 - k, 2.0) * 0.6 + nz * pow(1.0 - k, 2.0) * 0.4
        elif kind == "dash":
            v = nz * sin(PI * k) * 0.35
        elif kind == "swing":
            v = nz * sin(PI * k) * 0.2
        elif kind == "hurt":
            v = sin(TAU * (150.0 - 70.0 * k) * t) * (1.0 - k) * 0.7 + nz * 0.3 * (1.0 - k)
        elif kind == "pickup":
            var f = 660.0 if k < 0.5 else 990.0
            v = sin(TAU * f * t) * (1.0 - k) * 0.45
        elif kind == "click":
            v = sin(TAU * 900.0 * t) * pow(1.0 - k, 4.0) * 0.4
        elif kind == "door":
            v = sin(TAU * (110.0 + 90.0 * k) * t) * sin(PI * k) * 0.5 + nz * 0.1 * sin(PI * k)
        elif kind == "boss":
            v = sin(TAU * (60.0 + 8.0 * sin(t * 25.0)) * t) * sin(PI * k) * 0.8 + nz * 0.15 * sin(PI * k)
        elif kind == "parry":
            v = (sin(TAU * 1300.0 * t) + sin(TAU * 1950.0 * t)) * pow(1.0 - k, 3.0) * 0.3
        elif kind == "levelup":
            v = sin(TAU * notes[int(min(int(k * 4.0), 3))] * t) * (1.0 - k * 0.6) * 0.4
        elif kind == "slam":
            v = sin(TAU * (90.0 - 50.0 * k) * t) * pow(1.0 - k, 2.0) * 0.9 + nz * pow(1.0 - k, 4.0) * 0.4
        elif kind == "shoot":
            v = sin(TAU * (700.0 - 400.0 * k) * t) * pow(1.0 - k, 2.0) * 0.3
        var s = int(clamp(v, -1.0, 1.0) * 28000.0)
        bytes[i * 2] = s & 255
        bytes[i * 2 + 1] = (s >> 8) & 255
    var st = AudioStreamSample.new()
    st.format = AudioStreamSample.FORMAT_16_BITS
    st.mix_rate = RATE
    st.stereo = false
    st.data = bytes
    return st

# A slow dark drone that loops seamlessly (8 seconds, whole cycles).
func _drone(freqs):
    var rate = 11025
    var dur = 8.0
    var n = int(rate * dur)
    var bytes = PoolByteArray()
    bytes.resize(n * 2)
    for i in range(n):
        var t = float(i) / rate
        var lfo1 = 0.5 + 0.5 * sin(TAU * 0.25 * t)
        var lfo2 = 0.5 + 0.5 * sin(TAU * 0.125 * t + 1.0)
        var v = sin(TAU * freqs[0] * t) * 0.5 + sin(TAU * freqs[1] * t) * 0.35
        v += sin(TAU * freqs[2] * t) * 0.2 * lfo1 + sin(TAU * freqs[3] * t) * 0.12 * lfo2
        var s = int(clamp(v * 0.5, -1.0, 1.0) * 28000.0)
        bytes[i * 2] = s & 255
        bytes[i * 2 + 1] = (s >> 8) & 255
    var st = AudioStreamSample.new()
    st.format = AudioStreamSample.FORMAT_16_BITS
    st.mix_rate = rate
    st.stereo = false
    st.data = bytes
    st.loop_mode = AudioStreamSample.LOOP_FORWARD
    st.loop_begin = 0
    st.loop_end = n
    return st
